  "contrat": {
    "version": "1.0",
    "principe": [
      "Tous les joins de pilotage sont globaux : le même numéro dans toutes les pièces.",
      "Le C# (slot 1) connaît la pièce affichée par chaque écran : il applique l'action à cette pièce, pose Room_Select# (a10) et Room_Active_nn sur l'EISC, puis recopie l'action sur le même join.",
      "Feedback des écrans : calculé par le C# (déploiement) ou par js/local-feedback.js (vitrine) sur les mêmes joins.",
      "Sur le symbole EISC : SORTIE = ce que le slot 2 reçoit (nom nu = action, Rnn_xxx_fb = état tenu par le C#) ; ENTRÉE = ce que le slot 2 renvoie (suffixe _Actual).",
      "Bloc pièce EISC : join = 1000 + (id-1)*100 + offset. Réservé aux échanges C# ↔ slot 2, jamais émis par un écran."
    ],
    "eisc": {
      "actif": true,
      "ipid": "0xF0",
      "adresseIp": "127.0.0.2",
      "slotCible": 2
    },
    "ecrans": {
      "tsw": {
        "ipid": "0x03",
        "modele": "TSW-1070"
      },
      "xpanel": {
        "ipid": "0x04"
      },
      "ipad": {
        "ipid": "0x05",
        "projet": "showroomnyon"
      },
      "iphone": {
        "ipid": "0x06",
        "projet": "showroomnyon"
      }
    },
    "limites": {
      "piecesMax": 30,
      "circuitsMax": 20,
      "scenesMax": 8,
      "actionsMax": 8,
      "actionsMaisonMax": 8,
      "servicesMax": 8,
      "favorisMax": 8,
      "sourcesMax": 8,
      "camerasMax": 8,
      "parcourirMax": 8
    },
    "signauxGlobaux": {
      "digital": {
        "11-40": {
          "nom": "Room_Select_{n}",
          "sens": "↔",
          "desc": "Afficher la pièce n (join = 10+n) ; fb = pièce affichée par cet écran. Sur l'EISC : Room_Active_{n}, un seul haut, miroir de a10."
        },
        "51-58": {
          "nom": "House_Action_{n}",
          "sens": "↔",
          "desc": "Action maison n (maison.actions[n-1] : Welcome, Goodbye…) ; fb = impulsion 1,4 s « action appliquée »"
        },
        "59": {
          "nom": "Room_Off",
          "sens": "↔",
          "desc": "Bouton Marche/Arrêt de la barre du bas dans une pièce : éclairages à 0, musique et vidéo arrêtées"
        },
        "60": {
          "nom": "House_AllOff",
          "sens": "→",
          "desc": "Bouton Marche/Arrêt de la barre du bas sur l'accueil : toute la maison éteinte"
        },
        "61-68": {
          "nom": "Room_Action_{n}",
          "sens": "↔",
          "desc": "Action n de la pièce affichée (pieces[].actions[n-1]) ; fb = impulsion 1,4 s"
        },
        "71-78": {
          "nom": "Light_Scene_{n}",
          "sens": "↔",
          "desc": "Scène d'éclairage n de la pièce affichée (niveaux dans pieces[].pilotages.eclairages.scenes[n-1].niveaux) ; fb tenu = scène active"
        },
        "101": {
          "nom": "Lights_AllOn",
          "sens": "↔",
          "desc": "Tous les circuits de la pièce à 100 % ; fb = tous allumés"
        },
        "102": {
          "nom": "Lights_AllOff",
          "sens": "↔",
          "desc": "Tous les circuits à 0 ; fb = tous éteints"
        },
        "103": {
          "nom": "Lights_DimUp",
          "sens": "→",
          "desc": "All Lights + : tous les circuits +10 %"
        },
        "104": {
          "nom": "Lights_DimDown",
          "sens": "→",
          "desc": "All Lights − : tous les circuits −10 %"
        },
        "111-130": {
          "nom": "Light_{n}_Toggle",
          "sens": "↔",
          "desc": "Interrupteur du circuit n (1..20) : 0 ↔ dernier niveau (100 % par défaut) ; fb = circuit allumé"
        },
        "141": {
          "nom": "House_Lights_AllOff",
          "sens": "→",
          "desc": "Accueil, tuile Lights : éteint tous les circuits de la maison"
        },
        "201-208": {
          "nom": "Video_Remote_{n}",
          "sens": "→",
          "desc": "Télécommande Apple TV de la pièce : 1 Menu, 2 Lecture/Pause, 3 TV/Accueil, 4 Haut, 5 Bas, 6 Gauche, 7 Droite, 8 Sélection"
        },
        "231-238": {
          "nom": "Camera_Select_{n}",
          "sens": "↔",
          "desc": "Afficher la caméra n ; fb = caméra affichée"
        },
        "251": {
          "nom": "Video_Off",
          "sens": "↔",
          "desc": "Arrêt de la vidéo de la pièce ; fb tenu = vidéo arrêtée"
        },
        "261-268": {
          "nom": "Video_Source_{n}",
          "sens": "↔",
          "desc": "Source vidéo n dans la pièce affichée (allume) ; fb = source active"
        },
        "281-288": {
          "nom": "Music_Service_{n}",
          "sens": "↔",
          "desc": "Service audio n (musique.services[n-1]) dans la pièce affichée, démarre la lecture ; fb = service actif"
        },
