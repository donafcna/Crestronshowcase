        "themes": {
          "description": "[PRÉVU v2 — sans effet aujourd'hui] Thèmes proposés dans Réglages. Absent = les trois thèmes, Sombre par défaut.",
          "x-etat": "prevu",
          "type": "object",
          "properties": {
            "disponibles": {
              "description": "[PRÉVU v2 — sans effet aujourd'hui] Thèmes proposés (au moins un).",
              "x-etat": "prevu",
              "type": "array",
              "items": {
                "$ref": "#/definitions/theme"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "parDefaut": {
              "description": "[PRÉVU v2 — sans effet aujourd'hui] Thème au premier démarrage d'un appareil (le choix de l'utilisateur est ensuite mémorisé).",
              "x-etat": "prevu",
              "allOf": [
                {
                  "$ref": "#/definitions/theme"
                }
              ]
            }
          }
        },
        "langues": {
          "description": "[PRÉVU v2 — sans effet aujourd'hui] Langues proposées dans Réglages. Absent = meta.languesDisponibles, sinon toutes.",
          "x-etat": "prevu",
          "type": "object",
          "properties": {
            "disponibles": {
              "description": "[PRÉVU v2 — sans effet aujourd'hui] Langues proposées (au moins une).",
              "x-etat": "prevu",
              "type": "array",
              "items": {
                "$ref": "#/definitions/langue"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "parDefaut": {
              "description": "[PRÉVU v2 — sans effet aujourd'hui] Langue au premier démarrage d'un appareil.",
              "x-etat": "prevu",
              "allOf": [
                {
                  "$ref": "#/definitions/langue"
                }
              ]
            }
          }
        },
        "controlesGlobaux": {
          "description": "[PRÉVU v2 — sans effet aujourd'hui] Boutons de l'entête (alarme, caméras, contrôle global, recherche, réglages). Surcharge possible par pièce : pieces[].interface.controlesGlobaux.",
          "x-etat": "prevu",
          "type": "object",
          "properties": {
            "parDefaut": {
              "description": "[PRÉVU v2 — sans effet aujourd'hui] Boutons affichés sur toutes les pages, dans l'ordre.",
              "x-etat": "prevu",
              "type": "array",
              "items": {
                "$ref": "#/definitions/controleGlobal"
              },
              "uniqueItems": true
            },
            "general": {
              "description": "[PRÉVU v2 — sans effet aujourd'hui] Boutons de la page « Général » de l'iPad général (vue d'ensemble).",
              "x-etat": "prevu",
              "type": "array",
              "items": {
                "$ref": "#/definitions/controleGlobal"
              },
              "uniqueItems": true
            }
          }
        },
        "description": {
          "type": "string"
        },
        "rechercheDescription": {
          "type": "string"
        }
      }
