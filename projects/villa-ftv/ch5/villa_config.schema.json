              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 30
            },
            "etats": {
              "description": "[PRÉVU v2 — sans effet aujourd'hui] Pastilles d'état dans le menu de gauche (iPad général) : source A/V allumée, lumière allumée. Le pont v6 garde déjà en cache les retours des autres pièces.",
              "x-etat": "prevu",
              "type": "object",
              "properties": {
                "audioVideo": {
                  "description": "[PRÉVU v2 — sans effet aujourd'hui] Pastille « source allumée ».",
                  "x-etat": "prevu",
                  "type": "boolean"
                },
                "eclairage": {
                  "description": "[PRÉVU v2 — sans effet aujourd'hui] Pastille « lumière allumée ».",
                  "x-etat": "prevu",
                  "type": "boolean"
                }
              }
            }
          }
        },
        "recherche": {
          "description": "Bouton « Recherche » / actions rapides (v6.2).",
          "x-etat": "actif",
          "type": "object",
          "properties": {
            "actif": {
              "type": "boolean"
            },
