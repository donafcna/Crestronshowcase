{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crestrongui.vercel.app/schemas/villa_config.schema.json",
  "title": "villa_config.json — configuration d'un projet Fréquence TV (Core Villa FTV)",
  "description": "Généré par tools/build-config-schema.py. Les clés [PRÉVU v2] décrivent la feuille de route : elles sont acceptées mais sans effet tant qu'elles ne sont pas implémentées. Guide : docs/02_CONFIG_JSON.md ; inventaire et cible : docs/10_CONFIG_JSON_V2.md.",
  "type": "object",
  "required": [
    "meta",
    "pieces"
  ],
  "definitions": {
    "langue": {
      "description": "Code langue ISO 639-1. Langues du GUI aujourd'hui : fr, en, es, de, ru.",
      "x-etat": "actif",
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "theme": {
      "description": "Thème du GUI : dark = Sombre, light = Clair, glass = Verre dépoli.",
      "x-etat": "actif",
      "type": "string",
      "enum": [
        "dark",
        "light",
        "glass"
      ]
    },
    "controleGlobal": {
      "description": "[PRÉVU v2 — sans effet aujourd'hui] Bouton de l'entête : alarme, cameras, controleGlobal, recherche, reglages.",
      "x-etat": "prevu",
      "type": "string",
      "enum": [
        "alarme",
        "cameras",
        "controleGlobal",
        "recherche",
        "reglages"
      ]
    },
    "plage": {
      "description": "Plage réglable.",
      "x-etat": "actif",
      "type": "object",
      "required": [
        "min",
        "max",
        "pas"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "pas": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "consigne": {
          "description": "Consigne au démarrage.",
          "x-etat": "actif",
          "type": "number"
        }
      }
    },
    "idPiece": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "actif": {
      "description": "false = module retiré de la pièce (onglet/bouton masqué).",
      "x-etat": "actif",
      "type": "boolean",
      "default": true
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "description": "Identité du projet et réglages techniques.",
      "x-etat": "actif",
      "type": "object",
      "properties": {
        "projet": {
          "description": "Nom affiché du projet (titre, XPanel, programme SIMPL).",
          "x-etat": "actif",
          "type": "string",
          "minLength": 1
        },
        "integrateur": {
          "description": "[INUTILISÉ] Société intégratrice (information).",
          "x-etat": "inutilise",
          "type": "string"
        },
        "description": {
          "description": "[INUTILISÉ] Description libre (information).",
          "x-etat": "inutilise",
          "type": "string"
        },
        "coreOrigine": {
          "description": "[INUTILISÉ] Version du Core dont ce projet est issu (information).",
          "x-etat": "inutilise",
          "type": "string"
        },
        "version": {
          "description": "Version de la configuration, alignée par deploy.ps1.",
          "x-etat": "actif",
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.-]+)?$"
        },
        "mode": {
          "description": "deploiement = chez le client (retours du processeur) ; showcase = site vitrine (retours simulés). Jamais « showcase » dans un dépôt projet.",
          "x-etat": "actif",
          "type": "string",
          "enum": [
            "deploiement",
            "showcase"
          ]
        },
        "backend": {
          "description": "simpl = un seul programme SIMPL (v6.0, pont direct) ; csharp ou absent = C# slot 1 + SIMPL slot 2 (v5).",
          "x-etat": "actif",
          "type": "string",
          "enum": [
            "simpl",
            "csharp"
          ]
        },
        "interface": {
          "description": "Variante de disposition. connect = interface épurée « Connect » (v5.4). Absent = GUI standard.",
          "x-etat": "actif",
          "type": "string",
          "enum": [
            "connect"
          ]
        },
        "fonctionsRetirees": {
          "description": "[INUTILISÉ] Fonctions retirées du projet (information pour le générateur et la doc).",
          "x-etat": "inutilise",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "audioVideo",
              "alarme",
              "cameras"
            ]
          }
        },
        "tracesConsole": {
          "description": "false = debugger propre (aucune trace console ni s100).",
          "x-etat": "actif",
          "type": "boolean"
        },
        "tracesLatence": {
          "description": "Traces [LAT] de mesure de latence (iPhone).",
          "x-etat": "actif",
          "type": "boolean"
        },
        "dateModification": {
          "description": "[INUTILISÉ] Date de dernière modification (information).",
          "x-etat": "inutilise",
          "type": "string"
        },
        "langueReference": {
          "description": "Langue dans laquelle sont écrits les noms du fichier (pièces, scènes, circuits). Les tables « traductions » partent de cette langue.",
          "x-etat": "actif",
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "languesDisponibles": {
          "description": "[INUTILISÉ] Remplacé par interface.langues.disponibles (v2). Lu en repli quand ce bloc est absent.",
          "x-etat": "inutilise",
          "type": "array",
          "items": {
            "$ref": "#/definitions/langue"
          },
          "uniqueItems": true
        },
        "aide": {
          "description": "[INUTILISÉ] Aide au remplissage (information).",
          "x-etat": "inutilise",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "projet",
        "version",
        "mode"
      ]
    },
    "interface": {
      "description": "Ce que l'utilisateur voit : navigation, recherche, thèmes, langues, contrôles globaux.",
      "x-etat": "actif",
      "type": "object",
      "properties": {
        "menuPieces": {
          "description": "Menu de gauche (v6.1, js/nav-pieces.js). ?menu=0|1 et ?room=N dans l'adresse priment.",
          "x-etat": "actif",
          "type": "object",
          "properties": {
            "visible": {
              "description": "false = pas de menu de gauche ; titre = pièce, appui = choix de pièce.",
              "x-etat": "actif",
              "type": "boolean"
            },
            "pieces": {
              "description": "Pièces proposées, dans l'ordre ([] = toutes les pièces actives).",
              "x-etat": "actif",
