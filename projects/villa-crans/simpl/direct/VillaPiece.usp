/* Villa Crans v6.0 - module de piece, une instance par piece (GENERE par simpl/direct/generate_simpl.js,
   ne pas modifier a la main : modifier villa_config.json puis relancer le generateur).
   Parametre Piece : numero de la piece (1..15), choisit la config embarquee de la piece.
   Entrees Btn_* / In_* : appuis et valeurs des ecrans (bloc de joins de la piece, tous ecrans confondus).
   Sorties Fb_* / Txt_* : retours vers les ecrans. Pilote_* / Retour_* : a cabler aux pilotes reels (joins vides).
   G[1..10] : commandes de centralisation venant de VillaGlobal.usp. */
#SYMBOL_NAME "Villa Crans - Piece"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#DEFINE_CONSTANT NBC 20
#DEFINE_CONSTANT NBM 12

DIGITAL_INPUT Btn_Consigne_Plus, Btn_Consigne_Moins, Btn_CVC_Marche, Btn_CVC_Arret, Btn_Sauna_Marche, Btn_Sauna_Arret, 
    Btn_Sauna_Plus, Btn_Sauna_Moins, Btn_Hammam_Marche, Btn_Hammam_Arret, Btn_Hammam_Plus, Btn_Hammam_Moins, 
    Btn_Musique, Btn_Suivre_Video, Btn_Mute, Btn_AV_Off, Btn_Media_Lecture, Btn_Media_Suivant, 
    Btn_Media_Precedent, Btn_Scene[4], Btn_Memoriser[4], Btn_Ventilation[4], Btn_Groupe[9], Btn_Monter[12], 
    Btn_Stop[12], Btn_Descendre[12], Btn_Lam_Horaire[12], Btn_Lam_Stop[12], Btn_Lam_Antihoraire[12], 
    Btn_Scene_Stores[4], Btn_Source[5], G[10];
ANALOG_INPUT In_Consigne, In_Source, In_Volume, In_Volume_Media, In_Ventilation, In_Sauna_Consigne, In_Hammam_Consigne, 
    Retour_Temperature, Retour_Sauna_Mesure, Retour_Hammam_Mesure;
STRING_INPUT Retour_Mode$[40];
ANALOG_INPUT In_Circuit[20], Retour_Circuit[20];
DIGITAL_OUTPUT Fb_CVC_Marche, Fb_CVC_Arret, Fb_Sauna_Marche, Fb_Sauna_Arret, Fb_Hammam_Marche, Fb_Hammam_Arret, Fb_Musique, 
    Fb_Suivre_Video, Fb_Mute, Fb_AV_Off, Pilote_CVC_Marche, Pilote_Sauna_Marche, Pilote_Hammam_Marche, 
    Pilote_Mute, Pilote_Musique, Pilote_AV_Off, Pilote_Media_Lecture, Pilote_Media_Suivant, 
    Pilote_Media_Precedent, Fb_Scene[4], Fb_Memorisee[4], Fb_Ventilation[4], Fb_Scene_Stores[4], Fb_Source[5], 
    Pilote_Scene[4], Pilote_Monter[12], Pilote_Stop[12], Pilote_Descendre[12], Pilote_Lam_Horaire[12], 
    Pilote_Lam_Stop[12], Pilote_Lam_Antihoraire[12], Pilote_Groupe[9], Pilote_Scene_Stores[4];
ANALOG_OUTPUT Fb_Consigne, Fb_Source_Active, Fb_Volume, Fb_Source_Audio, Fb_Volume_Media, Fb_Ventilation_A, 
    Fb_Sauna_Consigne, Fb_Hammam_Consigne, Fb_Sauna_Mesure, Fb_Hammam_Mesure, Pilote_Consigne, 
    Pilote_Ventilation, Pilote_Sauna_Consigne, Pilote_Hammam_Consigne, Pilote_Source, Pilote_Volume, 
    Pilote_Volume_Media;
STRING_OUTPUT Txt_Temperature$, Txt_Mode$, Txt_Consigne$, Txt_Sauna_Consigne$, Txt_Hammam_Consigne$, Txt_Sauna_Mesure$, 
    Txt_Hammam_Mesure$;
ANALOG_OUTPUT Fb_Circuit[20], Pilote_Circuit[20];

INTEGER_PARAMETER Piece;
#BEGIN_PARAMETER_PROPERTIES Piece
    propValidUnits = unitDecimal;
    propDefaultValue = 1d;
    propList = { 1d, "01 Salle_de_jeux" },
               { 2d, "02 Chambre_maman" },
               { 3d, "03 Chambre_papa" },
               { 4d, "04 Suite_amis" },
               { 5d, "05 Chambre_amis" },
               { 6d, "06 Chambre_2" },
               { 7d, "07 Bureau" },
               { 8d, "08 Home_cinema" },
               { 9d, "09 Chambre_3" },
               { 10d, "10 Suite_invites" },
               { 11d, "11 Terrasse_et_jardin" },
               { 12d, "12 Piscine_et_spa" },
               { 13d, "13 Sauna_et_hammam" },
               { 14d, "14 Pool_house" },
               { 15d, "15 Garage_et_ateliers" };
#END_PARAMETER_PROPERTIES

NONVOLATILE INTEGER Initialise;
NONVOLATILE INTEGER Niveaux[4][NBC], Memorisee[4];
INTEGER SceneActive, Consigne, Marche, Vent, Source, Musique, Mute, Volume, VolumeMedia;
INTEGER SaunaOn, HammamOn, SaunaCons, HammamCons, SaunaMes, HammamMes, TempMes, TempRecue, SaunaRecue, HammamRecue, StoresScene;
INTEGER NbCircuits, Empreinte, ConsMin, ConsMax, ConsPas, ConsInit, MarcheInit, VentInit;
INTEGER Niveau[NBC], TypeMoteur[NBM], Defaut[4][NBC];

