/* Villa Crans v6.0 - module global (GENERE par simpl/direct/generate_simpl.js). Alarme : le code saisi part
   sur PILOTE_ALARME_Code ; la centrale repond par RETOUR_ALARME_Code_Accepte / _Refuse. Sans reponse dans le delai
   de contrat.alarme.delaiReponseCentraleMs, repli local sur contrat.alarme.codeParDefaut (vide = refus).
   Centralisation 401-411 : retours en interlock par famille, et commandes G[1..10] vers tous les modules de piece. */
#SYMBOL_NAME "Villa Crans - Global"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#DEFINE_CONSTANT DELAI 120

DIGITAL_INPUT Btn_Armer, Btn_Desarmer, Btn_Code_Efface, Btn_Partition[12], Btn_Central[11], Retour_Code_Accepte, 
    Retour_Code_Refuse;
STRING_INPUT In_Code$[20];
DIGITAL_OUTPUT Fb_Armer, Fb_Desarmer, Fb_Code_Valide, Fb_Code_Refuse, Fb_Partition[12], Fb_Central[11], G[10], Pilote_Armer, 
    Pilote_Desarmer, Pilote_Partition[12];
STRING_OUTPUT Pilote_Code$;

STRING Saisie[20];
INTEGER Arme, Attente, Vacances;
NONVOLATILE INTEGER EtatPartition[4];

FUNCTION MajAlarme()
{
    INTEGER p;
    Fb_Armer = Arme; Fb_Desarmer = !Arme;
    for (p = 1 to 4) { Fb_Partition[(p - 1) * 3 + 1] = (EtatPartition[p] = 1); Fb_Partition[(p - 1) * 3 + 2] = (EtatPartition[p] = 2); Fb_Partition[(p - 1) * 3 + 3] = (EtatPartition[p] = 0); }
}
CHANGE In_Code$
{
    Saisie = In_Code$;
    if (Len(Saisie) = 0) return;
    Pilote_Code$ = Saisie;
    Attente = 1;
    Wait(DELAI, Repli) { if (Attente) { Attente = 0; if (Saisie = "1234") { Pulse(50, Fb_Code_Valide); } else { Pulse(50, Fb_Code_Refuse); } } }
}
PUSH Retour_Code_Accepte { if (Attente) { Attente = 0; CancelWait(Repli); Pulse(50, Fb_Code_Valide); } }
PUSH Retour_Code_Refuse { if (Attente) { Attente = 0; CancelWait(Repli); Pulse(50, Fb_Code_Refuse); } }
PUSH Btn_Code_Efface { Saisie = ""; }
PUSH Btn_Armer { Arme = 1; MajAlarme(); Pulse(50, Pilote_Armer); }
PUSH Btn_Desarmer { Arme = 0; MajAlarme(); Pulse(50, Pilote_Desarmer); }
PUSH Btn_Partition
{
    INTEGER k, p, a;
    k = GetLastModifiedArrayIndex(); p = ((k - 1) / 3) + 1; a = ((k - 1) MOD 3);
    if (a = 0) { EtatPartition[p] = 1; } else if (a = 1) { EtatPartition[p] = 2; } else { EtatPartition[p] = 0; }
    MajAlarme(); Pulse(50, Pilote_Partition[k]);
}
PUSH Btn_Central
{
    INTEGER k, i, deb, fin;
    k = GetLastModifiedArrayIndex();
    if (k <= 9)
    {
        deb = (((k - 1) / 3) * 3) + 1; fin = deb + 2;
        for (i = deb to fin) { Fb_Central[i] = (i = k); }
        Pulse(50, G[k]);
    }
    else if (k = 10) { Vacances = 1; Fb_Central[10] = 1; Fb_Central[11] = 0; Pulse(50, G[10]); }
    else { Vacances = 0; Fb_Central[10] = 0; Fb_Central[11] = 1; }
}
FUNCTION Main()
{
    WaitForInitializationComplete();
    Arme = 0; Vacances = 0; Fb_Central[11] = 1; MajAlarme();
}
