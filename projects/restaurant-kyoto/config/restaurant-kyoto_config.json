  "contrat": {
    "version": "1.0",
    "principe": [
      "Tous les joins de pilotage sont globaux : le même numéro dans toutes les zones.",
      "Le C# (slot 1) connaît la zone affichée par chaque écran (_activeRoomPerDevice, 0 = tout le restaurant) : il applique l'action à cette zone (ou à toutes), pose Room_Select# (a10) sur l'EISC, puis recopie l'impulsion sur le même join. Le slot 2 route avec des buffers validés par Room_Active_nn (d101-117, un seul haut = a10 ; Room_Active_00 = d100 quand l'action vise tout le restaurant).",
      "Feedback des écrans : toujours calculé par le C#. Le slot 2 renvoie les mesures réelles par les entrées _Actual (blocs zone et globaux restaurant) ; elles font foi dès réception.",
      "Sur le symbole EISC : SORTIE = ce que le slot 2 reçoit (nom nu = action, Rnn_xxx_fb = état tenu par le C#) ; ENTRÉE = ce que le slot 2 renvoie (suffixe _Actual).",
      "Bloc zone EISC : join = 1000 + (id-1)*100 + offset. Réservé aux échanges C# ↔ slot 2, jamais émis par un écran.",
      "Scènes PAR ZONE (Scene_x appliquée à la zone a10 ; a10 = 0 = toutes). Climat, musique, service et couverts sont globaux (bloc 'restaurant')."
    ],
    "eisc": { "actif": true, "ipid": "0xF0", "adresseIp": "127.0.0.2", "slotCible": 2 },
    "limites": { "piecesMax": 17, "circuitsMax": 8, "scenesMax": 5, "eqMax": 3, "servicesMax": 4 },
    "signauxGlobaux": {
      "digital": {
        "51": { "nom": "Scene_Welcome", "sens": "↔", "desc": "Scène « Accueil » sur la zone affichée (a10 ; 0 = toutes les zones) ; fb tenu = scène active de la zone affichée" },
        "52": { "nom": "Scene_Dinner", "sens": "↔", "desc": "Scène « Dîner » (extérieur : « Allées »)" },
        "53": { "nom": "Scene_Rooftop", "sens": "↔", "desc": "Scène « Rooftop » (extérieur : « Jardins »)" },
        "54": { "nom": "Scene_Cleaning", "sens": "↔", "desc": "Scène « Nettoyage » (extérieur : « Tout allumé »)" },
        "55": { "nom": "Scene_Closed", "sens": "↔", "desc": "Scène « Fermeture » (extérieur : « Veille »)" },
        "100": { "nom": "Room_Select_All", "sens": "↔", "desc": "Sélection « Tout le restaurant » (Room_Select# = 0) ; fb = cet écran affiche tout le restaurant. Sur l'EISC : Room_Active_00, haut quand l'action vise toutes les zones." },
        "101-117": { "nom": "Room_Select_{n}", "sens": "↔", "desc": "Sélection directe de la zone n (join = 100+n) ; fb = zone affichée par cet écran. Sur l'EISC : Room_Active_{n}, un seul haut, miroir de a10." },
        "151": { "nom": "Lights_AllOn", "sens": "↔", "desc": "Tous les circuits de la zone affichée à 100 % ; fb = tous allumés" },
        "152": { "nom": "Lights_AllOff", "sens": "↔", "desc": "Tous les circuits à 0 ; fb = tous éteints" },
        "161-168": { "nom": "Light_{n}_Toggle", "sens": "↔", "desc": "Bascule 0/100 % du circuit n (1..8) ; fb = circuit allumé (> 0)" },
        "181": { "nom": "HVAC_Setpoint_Up", "sens": "→", "desc": "Consigne +pas (0,5 °C), bornée 18-25" },
        "182": { "nom": "HVAC_Setpoint_Down", "sens": "→", "desc": "Consigne −pas" },
        "241": { "nom": "Music_PlayPause", "sens": "↔", "desc": "Lecture / pause ; fb tenu = en lecture (entrée EISC Music_PlayPause_Actual = lecture réelle)" },
        "243-245": { "nom": "Music_EQ_{n}", "sens": "↔", "desc": "Égaliseur n (1 Lounge, 2 Dining, 3 Live) ; fb tenu (interlock)" },
        "250": { "nom": "Config_Resync", "sens": "→", "desc": "Demande de (ré)envoi de la configuration JSON" },
        "261": { "nom": "Service_Fluide", "sens": "↔", "desc": "« Tout traité » : service fluide (état 0) ; fb tenu (interlock)" },
        "262": { "nom": "Service_Sommelier", "sens": "↔", "desc": "Appel sommelier (état 1) ; fb tenu" },
        "263": { "nom": "Service_Accueil", "sens": "↔", "desc": "Appel accueil (état 2) ; fb tenu" },
        "264": { "nom": "Service_Cuisine", "sens": "↔", "desc": "Appel cuisine (état 3) ; fb tenu" }
      },
      "analog": {
        "10": { "nom": "Room_Select#", "sens": "↔", "desc": "Zone affichée par cet écran (0 = tout le restaurant, 1..17). Sur l'EISC : posé AVANT chaque recopie d'action → clé de bufferisation du slot 2" },
        "11-18": { "nom": "Light_{n}_Level#", "sens": "↔", "desc": "Niveau du circuit n (0-65535) ; curseur → C# (scène de la zone → personnalisée) ; fb = niveau" },
